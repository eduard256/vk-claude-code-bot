[Unit]
Description=VK bot for remote Claude Code control
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/user/vk-claude-code-bot
# claude лежит в ~/.local/bin — добавляем в PATH для субпроцессов
Environment=PATH=/home/user/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /home/user/vk-claude-code-bot/bot.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
