# Токен доступа сообщества VK. Нужны права: messages, manage.
# Управление сообществом -> Работа с API -> Ключи доступа.
VK_TOKEN=vk1.a.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID сообщества (число, без знака минус).
VK_GROUP_ID=123456789

# Твой личный VK user id. Бот отвечает только ему, остальных молча игнорирует.
ALLOWED_USER_ID=111111111

# Корневая папка: от неё показываются папки при /start и считаются
# относительные пути (одним словом). Абсолютные пути (с /) работают всегда.
BASE_DIR=/home/user
